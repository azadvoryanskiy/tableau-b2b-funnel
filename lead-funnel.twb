    <worksheet name="Channel matrix">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#FFFFFF" fontname="Tableau Semibold" fontsize="12">Volume vs. quality by channel</run>
            <run fontcolor="#8C8C87" fontname="Tableau Book" fontsize="9">
Bubble size = deals won. Dashed line = average conversion. Click a bubble to filter the page.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Olist leads 2018" name="federated.0b2bleadfunnel0olist0dash01" />
          </datasources>

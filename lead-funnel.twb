<?xml version='1.0' encoding='utf-8'?>
<workbook source-build="2024.3.0 (20243.24.1010.1014)" source-platform="mac" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <document-format-change-manifest>
    <SortTagCleanup />
  </document-format-change-manifest>
  <preferences />
  <datasources>
    <datasource caption="Olist leads 2018" inline="true" name="federated.0b2bleadfunnel0olist0dash01" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="olist_leads_2018" name="hyper.0b2bleadfunnel0olist0hyper01">
            <connection authentication="auth-none" author-locale="en_US" class="hyper" dbname="data/olist_leads_2018.hyper" default-settings="yes" port="" sslmode="" username="tableau_internal_user" />
          </named-connection>
        </named-connections>
        <relation connection="hyper.0b2bleadfunnel0olist0hyper01" name="Extract" table="[Extract].[Extract]" type="table" />
      </connection>
      <aliases enabled="yes" />
      <column caption="Lead ID" datatype="string" name="[lead_id]" role="dimension" type="nominal" />
      <column caption="First contact" datatype="date" name="[first_contact_date]" role="dimension" type="ordinal" />
      <column caption="Channel" datatype="string" name="[channel]" role="dimension" type="nominal" />
      <column caption="Landing page" datatype="string" name="[landing_page]" role="dimension" type="nominal" />
      <column caption="Landing page (top 10)" datatype="string" name="[landing_page_top]" role="dimension" type="nominal" />
      <column caption="Won" datatype="integer" name="[won]" role="measure" type="quantitative" />
      <column caption="Won date" datatype="date" name="[won_date]" role="dimension" type="ordinal" />
      <column caption="Days to close" datatype="integer" name="[days_to_close]" role="measure" type="quantitative" />
      <column caption="Time to close" datatype="string" name="[close_speed]" role="dimension" type="nominal">
        <aliases>
          <alias key="&quot;1. Within a week&quot;" value="Within a week" />
          <alias key="&quot;2. 8-14 days&quot;" value="8-14 days" />
          <alias key="&quot;3. 15-30 days&quot;" value="15-30 days" />
          <alias key="&quot;4. 31-60 days&quot;" value="31-60 days" />
          <alias key="&quot;5. 61-90 days&quot;" value="61-90 days" />
          <alias key="&quot;6. Over 90 days&quot;" value="Over 90 days" />
        </aliases>
      </column>
      <column caption="Business segment" datatype="string" name="[business_segment]" role="dimension" type="nominal" />
      <column caption="Segment (top 8)" datatype="string" name="[segment_top]" role="dimension" type="nominal" />
      <column caption="Lead type" datatype="string" name="[lead_type]" role="dimension" type="nominal" />
      <column caption="Business type" datatype="string" name="[business_type]" role="dimension" type="nominal" />
      <column caption="Sales rep" datatype="string" name="[sales_rep]" role="dimension" type="nominal" />
      <column caption="Sales rep (top 10)" datatype="string" name="[rep_top]" role="dimension" type="nominal" />
      <column caption="Leads" datatype="integer" default-format="n#,##0" name="[Calculation_1001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNT([lead_id])" />
      </column>
      <column caption="Deals won" datatype="integer" default-format="n#,##0" name="[Calculation_1002]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([won])" />
      </column>
      <column caption="Conversion" datatype="real" default-format="p0.0%" name="[Calculation_1003]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([won]) / COUNT([lead_id])" />
      </column>
      <column caption="Median days to close" datatype="real" default-format="n#,##0" name="[Calculation_1004]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MEDIAN([days_to_close])" />
      </column>
      <column caption="Share of leads" datatype="real" default-format="p0%" name="[Calculation_1005]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNT([lead_id]) / MIN({EXCLUDE [channel] : COUNT([lead_id])})" />
      </column>
      <column caption="Share of deals won" datatype="real" default-format="p0%" name="[Calculation_1006]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([won]) / MIN({EXCLUDE [channel] : SUM([won])})" />
      </column>
      <column caption="Average conversion" datatype="real" default-format="p0.0%" name="[Calculation_1007]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MIN({EXCLUDE [channel] : SUM([won]) / COUNT([lead_id])})" />
      </column>
      <column caption="Lead quality" datatype="string" name="[Calculation_1008]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_1003] &gt;= [Calculation_1007] THEN 'Above average' ELSE 'Below average' END" />
      </column>
      <column caption="Share of won deals by speed" datatype="real" default-format="p0%" name="[Calculation_1009]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([won]) / MIN({EXCLUDE [close_speed] : SUM([won])})" />
      </column>
      <column caption="Outcome" datatype="string" name="[Calculation_1010]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [won] = 1 THEN 'Won' ELSE 'Not won' END" />
      </column>
      <column-instance column="[Calculation_1008]" derivation="User" name="[usr:Calculation_1008:nk]" pivot="key" type="nominal" />
      <column-instance column="[Calculation_1010]" derivation="None" name="[none:Calculation_1010:nk]" pivot="key" type="nominal" />
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[usr:Calculation_1008:nk]" type="palette">
            <map to="#D6FA50">
              <bucket>"Above average"</bucket>
            </map>
            <map to="#6B6B66">
              <bucket>"Below average"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[none:Calculation_1010:nk]" type="palette">
            <map to="#D6FA50">
              <bucket>"Won"</bucket>
            </map>
            <map to="#4A4A47">
              <bucket>"Not won"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[:Measure Names]" type="palette">
            <map to="#6B6B66">
              <bucket>"[federated.0b2bleadfunnel0olist0dash01].[usr:Calculation_1005:qk]"</bucket>
            </map>
            <map to="#D6FA50">
              <bucket>"[federated.0b2bleadfunnel0olist0dash01].[usr:Calculation_1006:qk]"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <actions>
    <action caption="Filter by channel (Channel matrix)" name="[Action1_B2BFUNNEL0001]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Funnel" type="sheet" worksheet="Channel matrix" />
      <link caption="Filter by channel" delimiter="," escape="\" expression="tsl:Funnel?%5Bfederated.0b2bleadfunnel0olist0dash01%5D.%5Bchannel%5D~s0=&lt;[channel]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Channel matrix,Leads vs deals" />
        <param name="target" value="Funnel" />
      </command>
    </action>
    <action caption="Filter by channel (Leads vs deals)" name="[Action2_B2BFUNNEL0002]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Funnel" type="sheet" worksheet="Leads vs deals" />
      <link caption="Filter by channel" delimiter="," escape="\" expression="tsl:Funnel?%5Bfederated.0b2bleadfunnel0olist0dash01%5D.%5Bchannel%5D~s0=&lt;[channel]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Channel matrix,Leads vs deals" />
        <param name="target" value="Funnel" />
      </command>
    </action>
  </actions>
